# ─── Django / AI ─────────────────────────────────────────────────────────────
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Recommended: gemini-2.5-flash (separate free-tier quota from 3.5 Flash)
# Avoid gemini-3.5-flash on free tier — only ~20 requests/day
GEMINI_MODEL=gemini-2.5-flash
# Tried when primary model is rate-limited (429), overloaded (503), or missing
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
